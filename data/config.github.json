    "reddit": {
      "enabled": false,
      "subreddits": [],
      "users": [],
      "fetch_comments": 10
    },
    "telegram": {
      "enabled": false,
      "channels": []
    }
  },
  "collection": {
    "time_window_hours": 12
  },
  "digest": {
    "max_items": null,
    "profile_order": [
      "tech-news",
      "tech-blog",
      "finance-news"
    ],
    "category_groups": {},
    "default_group": "other",
    "default_group_limit": null
  },
  "webhook": {
    "enabled": false,
    "url_env": "HORIZON_WEBHOOK_URL"
  }
}
