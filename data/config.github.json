{
  "ai": {
    "provider": "openai",
    "model": "openrouter/free",
    "base_url": "https://openrouter.ai/api/v1",
    "api_key_env": "OPENAI_API_KEY",
    "temperature": 0.3,
    "max_tokens": 4096,
    "throttle_sec": 3,
    "languages": [
      "zh"
    ],
    "analysis_concurrency": 1,
    "enrichment_concurrency": 1
  },
  "processing": {
    "profiles_dir": "profiles",
    "default_profile": "tech-news",
    "profile_settings": {
      "tech-news": {
        "threshold":6.0,
        "topic_dedup": true
      },
      "tech-blog": {
        "threshold": 5.0,
        "topic_dedup": false
      },
      "finance-news": {
        "threshold": 6.0,
        "topic_dedup": true
      }
    }
  },
  "sources": {
    "github": [
      {
        "type": "repo_releases",
        "owner": "vllm-project",
        "repo": "vllm",
        "enabled": true,
        "profile": "tech-news"
      }
    ],
    "hackernews": {
      "enabled": true,
      "fetch_top_stories": 30,
      "min_score": 150,
      "profile": "tech-news"
    },
    "rss": [
      {
        "name": "华尔街日报 - 全球新闻",
        "url": "https://feeds.a.dj.com/rss/RSSWorldNews.xml",
        "enabled": true,
        "category": "finance",
        "profile": "finance-news"
      }, 
      {
        "name": "The Guardian - World News (卫报)",
        "url": "https://www.theguardian.com/world/rss",
        "enabled": true,
